# ─────────────────────────────────────────────────────────────────────────────
# MXVA environment. Copy to .env.local for development. Never commit real values.
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time:
# never put a secret in a NEXT_PUBLIC_* variable.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BRAND_NAME=MXVA
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Real Stripe checkout. Keep false until Phase B + C have passed end-to-end tests.
NEXT_PUBLIC_ENABLE_REAL_PAYMENTS=false
# Real vision / image-edit / email providers. Keep false until Phase C keys are set.
NEXT_PUBLIC_ENABLE_REAL_AI=false
# Development-only mock payment + mock result. Ignored (always off) in production builds.
NEXT_PUBLIC_SHOW_DEV_PREVIEW=true
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Pricing (server-authoritative; the browser can never choose the price) ──
PRICE_USD_CENTS=2900
PRICE_VARIANT=usd_29

# ── Payments (Phase B) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Order metadata database (Phase B). Metadata only, never images. ─────────
DATABASE_URL=

# ── AI providers (Phase C) ──────────────────────────────────────────────────
VISION_API_KEY=
VISION_MODEL=
IMAGE_API_KEY=
IMAGE_EDIT_MODEL=gpt-image-2

# ── Email (Phase C) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=

# ── Security ────────────────────────────────────────────────────────────────
# 32+ random bytes, e.g. `openssl rand -base64 48`. Required in production.
COOKIE_SIGNING_SECRET=

# ── Photo limits ────────────────────────────────────────────────────────────
MAX_PHOTO_BYTES=8388608

# ── Analytics (Step 5). Empty = provider off. Photos/face data never sent. ──
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# ── SEO (Step 10) ───────────────────────────────────────────────────────────
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
