# ─────────────────────────────────────────────────────────────────────────────
# MXVA environment. Copy to .env.local for development. Never commit real values.
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time:
# never put a secret in a NEXT_PUBLIC_* variable.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BRAND_NAME=MXVA
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Real payment providers (card via Stripe, PIX via AbacatePay) wherever their keys are set.
# Development: test/sandbox keys + simulated report are fine; a method without keys stays simulated.
# Production: live keys + real AI + email are required, or that method is not offered.
NEXT_PUBLIC_ENABLE_REAL_PAYMENTS=false
# Real vision / image-edit / email providers. Keep false until Phase C keys are set.
NEXT_PUBLIC_ENABLE_REAL_AI=false
# Development-only mock payment + mock result. Ignored (always off) in production builds.
NEXT_PUBLIC_SHOW_DEV_PREVIEW=true
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Pricing (server-authoritative; the browser can never choose the price) ──
# Card (Stripe), in US cents.
PRICE_USD_CENTS=2900
PRICE_VARIANT=usd_29
# PIX (AbacatePay), in centavos. Only payable from a Brazilian bank account.
PRICE_BRL_CENTS=4799

# ── Card payments: Stripe (Phase B) ─────────────────────────────────────────
# sk_test_/pk_test_ for development. Production requires sk_live_ and the webhook secret.
STRIPE_SECRET_KEY=
# Dashboard → Developers → Webhooks → https://<domain>/api/stripe/webhook (see README).
STRIPE_WEBHOOK_SECRET=

# ── Order metadata database (Phase B). Metadata only, never images. ─────────
DATABASE_URL=

# ── AI providers (Phase C) ──────────────────────────────────────────────────
VISION_API_KEY=
# Vision + identity check (Responses API, strict JSON). Pinned snapshot, verified 12 Oct 2026.
VISION_MODEL=gpt-5.5-2026-04-23
IMAGE_API_KEY=
IMAGE_EDIT_MODEL=gpt-image-2

# ── Email (Phase C) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=
# Report queue: reports made at the same time (keep under your OpenAI image rate limit), how many
# may wait, the first retry pause, and where failure alerts go (order + error log, never images).
FULFILLMENT_CONCURRENCY=4
FULFILLMENT_MAX_QUEUED=300
FULFILLMENT_RETRY_DELAY_MS=30000
OWNER_ALERT_EMAIL=

# ── Staging (test-mode deploy) ──────────────────────────────────────────────
# true on a staging deploy: sandbox payment keys are allowed in the production build,
# "Simulate Pix payment" is available, and search engines are told not to index.
# Optional STAGING_PASSWORD (12+ characters) also puts the site behind a password (user
# "mxva"); webhooks and /api/health stay open. Remove both before launch.
STAGING=false
STAGING_PASSWORD=

# ── Security ────────────────────────────────────────────────────────────────
# 32+ random bytes, e.g. `openssl rand -base64 48`. Required in production.
COOKIE_SIGNING_SECRET=

# ── Photo limits ────────────────────────────────────────────────────────────
MAX_PHOTO_BYTES=8388608

# ── Analytics. Empty = provider off. Photos, answers and emails are never sent. ──
# PostHog project API key (phc_...). Events are forwarded server-side, anonymous, GeoIP off.
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
# Meta Conversions API (server-side; only for visitors who accept marketing cookies).
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v26.0
# Optional: Events Manager "Test events" code while validating the setup.
META_TEST_EVENT_CODE=
# Opt-in: include SHA-256 of the buyer email on Purchase (marketing consent only).
META_CAPI_SEND_HASHED_EMAIL=false

# ── SEO (Step 10) ───────────────────────────────────────────────────────────
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ── PIX via AbacatePay (Phase B, Brazil) ────────────────────────────────────
ABACATEPAY_API_KEY=
# true while the key is a Dev Mode (sandbox) key: no real money, payments simulated.
ABACATEPAY_SANDBOX=true
# Your own random secret; register the webhook as https://<domain>/api/abacatepay/webhook?webhookSecret=<this>
ABACATEPAY_WEBHOOK_SECRET=
# Optional: AbacatePay's key for verifying the X-Webhook-Signature HMAC.
ABACATEPAY_PUBLIC_KEY=
